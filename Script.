local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function corner(inst, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r) }, inst)
end

local function stroke(inst, color, thick, transp)
    return new("UIStroke", {
        Color = color, Thickness = thick, Transparency = transp,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
end

local function label(parent, text, size, font, color)
    return new("TextLabel", {
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = text, TextSize = size, Font = font, TextColor3 = color,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
end

local function tween(inst, t, props)
    local tw = TweenService:Create(inst, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function tweenEx(inst, t, style, dir, delay, props)
    local tw = TweenService:Create(inst, TweenInfo.new(t, style, dir, 0, false, delay or 0), props)
    tw:Play()
    return tw
end

local function strokeGradient(stk)
    return new("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(25, 45, 35)),
            ColorSequenceKeypoint.new(0.5, GREEN),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(25, 45, 35)),
        }),
    }, stk)
end

local function addShine(parent)
    local f = new("Frame", {
        Name = "Shine", Size = UDim2.new(1, 0, 1, 0), ZIndex = 0,
        BackgroundColor3 = Color3.fromRGB(200, 255, 225), BorderSizePixel = 0,
    }, parent)
    return new("UIGradient", {
        Rotation = 25, Offset = Vector2.new(-1, 0),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.4, 1),
            NumberSequenceKeypoint.new(0.5, 0.93),
            NumberSequenceKeypoint.new(0.6, 1),
            NumberSequenceKeypoint.new(1, 1),
        }),
    }, f)
end

