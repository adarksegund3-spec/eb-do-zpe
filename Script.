local conn = RunService.Heartbeat:Connect(function()
    local t = os.clock()
    local rot = (t * 50) % 360
    mainStrokeGrad.Rotation = rot
    barStrokeGrad.Rotation = rot
    logoStrokeGrad.Rotation = rot
    mainShine.Offset = Vector2.new(math.min(1, -1 + (((t - shineStart) % 6) / 6) * 3), 0)
    logoShine.Offset = Vector2.new(math.min(1, -1 + ((t % 5) / 5) * 3), 0)
    logoDot.BackgroundTransparency = 0.35 + 0.35 * math.sin(t * 3)
end)
table.insert(connections, conn)

gui.Destroying:Connect(function()
    pcall(stopMacro)
    pcall(HitboxMenu.destroy)
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
end)
