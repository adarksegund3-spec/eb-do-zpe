-- MOTOR DOS PARKOURS (decodifica e toca as gravacoes)
--------------------------------------------------------------------
local macroCache = {}
local Macro = { cleanup = nil, token = 0 }
local setStatus = function() end -- trocado quando a pagina for criada

local B64 = {}
do
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    for i = 1, #chars do B64[string.byte(chars, i)] = i - 1 end
end

local function b64decode(s)
    s = s:gsub("%s+", "")
    local out, n = {}, 0
    for i = 1, #s, 4 do
        local a, b, c, d = string.byte(s, i, i + 3)
        a, b = B64[a], B64[b]
        c = c and B64[c]
        d = d and B64[d]
        n += 1; out[n] = a * 4 + math.floor(b / 16)
        if c then n += 1; out[n] = (b % 16) * 16 + math.floor(c / 4) end
        if d then n += 1; out[n] = (c % 4) * 64 + d end
    end
    return out
end

local function getFrames(id)
    if macroCache[id] then return macroCache[id] end
    if not next(ZPData.macros) then
        local ok, d = pcall(function() return loadstring(game:HttpGet(DATA_URL))() end)
        if not ok or type(d) ~= "table" or type(d.macros) ~= "table" then
            return nil, "falha ao baixar os dados"
        end
        ZPData.macros, ZPData.states, ZPData.anims = d.macros, d.states, d.anims
    end
    local text = ZPData.macros[id]
    if not text then return nil, "sem dados" end

    local bytes = b64decode(text)
    local pos = 1
    local function rv()
        local r, shift = 0, 1
        while true do
            local b = bytes[pos]
            pos += 1
            if b < 128 then return r + b * shift end
            r += (b - 128) * shift
            shift *= 128
        end
    end
    local function rz()
        local v = rv()
        if v % 2 == 0 then return v / 2 else return -(v + 1) / 2 end
    end

    local ok, frames = pcall(function()
        local n = rv()
        local fr = {}
        local t, x, y, z, yaw = 0, 0, 0, 0, 0
        for i = 1, n do
            t += rz(); x += rz(); y += rz(); z += rz(); yaw += rz()
            local px, py, pz = x / 100, y / 100, z / 100
            fr[i] = {
                t = t / 1000,
                pos = Vector3.new(px, py, pz),
                cf = CFrame.new(px, py, pz) * CFrame.Angles(0, yaw / 1000, 0),
            }
            if i % 500 == 0 then task.wait() end
        end

        local k = 1
        for _ = 1, rv() do -- estados (Running, Jumping, ...)
            local len, si = rv(), rv()
            local name = ZPData.states[si]
            for _ = 1, len do
                if fr[k] then fr[k].state = name end
                k += 1
            end
        end

        k = 1
        for _ = 1, rv() do -- animacao dominante
            local len, ai = rv(), rv()
            local anim = ai > 0 and ZPData.anims[ai] or nil
            for _ = 1, len do
                if fr[k] then fr[k].anim = anim end
                k += 1
            end
        end

        -- velocidade derivada das posicoes
        for i = 1, n - 1 do
            local a, b = fr[i], fr[i + 1]
            local dt = b.t - a.t
            local d = b.pos - a.pos
            if dt > 0.004 and d.Magnitude < 8 then a.vel = d / dt else a.vel = Vector3.zero end
        end
        fr[n].vel = Vector3.zero
        return fr
    end)

    if not ok or type(frames) ~= "table" or #frames < 2 then
        return nil, "dados inv\u{00E1}lidos"
    end
    macroCache[id] = frames
    return frames
end

local function stopMacro(msg)
    Macro.token += 1
    local c = Macro.cleanup
    Macro.cleanup = nil
    if c then pcall(c) end
    setStatus(msg or "Parado", false)
end

local function playMacro(frames, name)
    stopMacro()

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then
        setStatus("Personagem indispon\u{00ED}vel", false)
        return
    end

    Macro.token += 1
    local token = Macro.token
    local animator = hum:FindFirstChildOfClass("Animator")
    local animate = char:FindFirstChild("Animate")
    local animateWasDisabled = animate and animate.Disabled
    local tracks, currentAnim, lastState = {}, nil, nil
    local n, idx = #frames, 1
    local conn

    -- desliga o Animate padrao enquanto roda (para nao misturar animacoes)
    if animate and animator then
        pcall(function() animate.Disabled = true end)
        pcall(function()
            for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do tr:Stop(0) end
        end)
    end

    local function setAnim(f)
        local a = f.anim
        if a == currentAnim then return end
        currentAnim = a
        if not animator then return end
        local key = a and tostring(a[1]) or nil
        for k, tr in pairs(tracks) do
            if k ~= key and tr.IsPlaying then pcall(function() tr:Stop(0.1) end) end
        end
        if not a then return end
        local tr = tracks[key]
        if not tr then
            local ok, t = pcall(function()
                local anim = Instance.new("Animation")
                anim.AnimationId = "rbxassetid://" .. key
                return animator:LoadAnimation(anim)
            end)
            if ok and t then
                tr = t
                tracks[key] = tr
                pcall(function() tr.Priority = Enum.AnimationPriority.Core end)
            end
        end
        if tr then
            pcall(function()
                if tr.IsPlaying then
                    tr:AdjustSpeed(a[2])
                else
                    tr:Play(0.1, 1, a[2])
                end
            end)
        end
    end

    Macro.cleanup = function()
        if conn then conn:Disconnect() end
        for _, tr in pairs(tracks) do
            pcall(function() tr:Stop(0.1) end)
        end
        if animate and animate.Parent and not animateWasDisabled then
            pcall(function() animate.Disabled = false end)
        end
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
    end

    hrp.CFrame = frames[1].cf
    local t0 = os.clock()
    setStatus("Rodando: " .. name, true)

    conn = RunService.Heartbeat:Connect(function()
        if Macro.token ~= token then return end
        if not hrp.Parent or hum.Health <= 0 or LocalPlayer.Character ~= char then
            stopMacro("Interrompido")
            return
        end

        local el = os.clock() - t0
        while idx < n and frames[idx + 1].t <= el do idx += 1 end
        local a = frames[idx]

        if idx >= n then
            hrp.CFrame = a.cf
            stopMacro("Conclu\u{00ED}do: " .. name)
            return
        end

        local b = frames[idx + 1]
        local cf = a.cf
        local span = b.t - a.t
        -- suaviza entre pontos; se houver "salto" grande na gravacao, nao interpola
        if span > 0 and (b.pos - a.pos).Magnitude < 8 then
            cf = a.cf:Lerp(b.cf, math.clamp((el - a.t) / span, 0, 1))
        end

        hrp.CFrame = cf
        hrp.AssemblyLinearVelocity = a.vel

        if a.state ~= lastState then
            lastState = a.state
            pcall(function() hum:ChangeState(Enum.HumanoidStateType[a.state]) end)
        end
        setAnim(a)
    end)
end

local requestId = 0
local function runMacroFile(id, name)
    if not id then
        setStatus("Ainda sem arquivo: " .. name, false)
        return
    end
    requestId += 1
    local mine = requestId
    task.spawn(function()
        setStatus("Carregando: " .. name .. "...", false)
        local frames, err = getFrames(id)
        if mine ~= requestId then return end -- outro clique aconteceu enquanto carregava
        if not frames then
            setStatus("Falha (" .. tostring(err) .. "): " .. name, false)
            return
        end
        playMacro(frames, name)
    end)
end

